# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Model + pricing (used for the cost ceiling; check current prices and update) ---
LLM_MODEL=claude-sonnet-5-5
PRICE_INPUT_PER_MTOK=3.0
PRICE_OUTPUT_PER_MTOK=15.0

# --- Search (optional: Tavily is used first if set, DuckDuckGo is the fallback) ---
TAVILY_API_KEY=

# --- Email delivery (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password
SMTP_FROM=you@example.com
SMTP_STARTTLS=true

# --- Guardrails ---
MAX_COST_USD=0.75
MAX_SUBQUESTIONS=5
MAX_ITERATIONS_PER_SUBQUESTION=6
MAX_TOTAL_ITERATIONS=30
MAX_STUCK_REPEATS=2

# --- Output folders ---
TRACES_DIR=traces
REPORTS_DIR=reports
